# Copy to .env and fill in. Without a .env, docker compose runs on
# http://localhost, which is fine for trying it out.

# Two subdomains pointing at this server. Attachments get their own so an
# uploaded file can never get at anyone's login.
PUBLIC_URL=https://chat.example.com
CONTENT_URL=https://chat-files.example.com

# Optional. Signs attachment links; if empty, one is made and kept in the
# data volume. Make one with: openssl rand -hex 32
SIGNING_SECRET=

# Max upload size to start with. You can change it on the admin page later.
MAX_SIZE_MB=100

# Calls. Only needed if you run the relay too (docker compose --profile calls up -d).
# TURN_SECRET is shared between the app and coturn: openssl rand -hex 32
# STUN_URLS=stun:chat.example.com:3478 stun:stun.l.google.com:19302
# TURN_URLS=turn:chat.example.com:3478?transport=udp turn:chat.example.com:3478?transport=tcp
# TURN_SECRET=
# TURN_REALM=chat.example.com
# The server's public IP (coturn needs to know it when it's behind NAT).
# TURN_EXTERNAL_IP=
